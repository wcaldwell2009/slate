# Copy this file to ".env" and fill in your own values.
# The .env file is never committed and never leaves your computer.

# --- Canvas (only needed to connect REAL Canvas; leave blank to use mock data) ---
CANVAS_BASE_URL=
CANVAS_API_TOKEN=

# --- Claude API (optional; enables smart categorize/simplify) ---
# Without this, Slate uses a built-in rule-based fallback instead.
ANTHROPIC_API_KEY=

# Set to "mock" to force fake Canvas data, "real" to use the token above.
# "auto" (default) uses real Canvas if a token is set, otherwise mock.
CANVAS_MODE=auto

# Port the local app runs on.
PORT=4173
